[run]
branch = True
source = .
relative_files = True
data_file = runs/quality/.coverage

[report]
# Keep the complete package denominator while emitting repository-relative XML paths.
include = risklab/*
show_missing = True
skip_empty = False

[xml]
output = runs/quality/coverage.xml

[json]
output = runs/quality/coverage.json

[html]
directory = runs/quality/html
